6\">Roteiro<\u002Fp>\n              <p style=\"margin: 0; font-size: 13.5px; font-weight: 300; line-height: 1.75; color: #1c1530; white-space: pre-line\">{{roteiro}}<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <p style=\"margin: 0 0 12px 0; font-size: 10.5px; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; color: #6c2ee6\">Legenda<\u002Fp>\n          <p style=\"margin: 0; font-size: 14px; font-weight: 300; line-height: 1.75; color: #1c1530; white-space: pre-line; overflow-wrap: anywhere\"><sc-for list=\"{{captionSegs}}\" as=\"c\" hint-placeholder-count=\"1\"><sc-if value=\"{{c.tag}}\"><span style=\"color: #6c2ee6; font-weight: 500\">{{c.t}}<\u002Fspan><\u002Fsc-if><sc-if value=\"{{c.plain}}\"><span>{{c.t}}<\u002Fspan><\u002Fsc-if><\u002Fsc-for><\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fx-dc>\n\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:1440,&quot;height&quot;:1240}}\">\nclass Component extends DCLogic {\n  constructor(...args) {\n    super(...args);\n    this.state = { open: null, slide: 0, playing: false, dragX: 0, dragging: false, menuOpen: false };\n    this.dialogEl = null;\n    this.lastFocus = null;\n\n    this.setDialog = (el) => { this.dialogEl = el; };\n    this.stop = (e) => { e.stopPropagation(); };\n    this.toggleMenu = () => this.setState({ menuOpen: !this.state.menuOpen });\n    this.close = () => {\n      this.setState({ open: null, playing: false, dragging: false, dragX: 0 });\n      const f = this.lastFocus;\n      setTimeout(() => { if (f && f.focus) f.focus(); }, 0);\n    };\n    this.go = (d) => {\n      const n = this.slideCount();\n      if (n < 2) return;\n      const s = Math.max(0, Math.min(n - 1, this.state.slide + d));\n      if (s !== this.state.slide) this.setState({ slide: s });\n    };\n    this.prev = () => this.go(-1);\n    this.next = () => this.go(1);\n    this.play = () => this.setState({ playing: true });\n    this.onKey = (e) => {\n      if (e.key === 'Escape') { e.preventDefault(); this.close(); }\n      else if (e.key === 'ArrowRight') { e.preventDefault(); this.go(1); }\n      else if (e.key === 'ArrowLeft') { e.preventDefault(); this.go(-1); }\n    };\n    this.ptrDown = (e) => {\n      if (this.slideCount() < 2) return;\n      if (e.target && e.target.closest && e.target.closest('button')) return;\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\n      this.sx = e.clientX;\n      this.vw = e.currentTarget.offsetWidth || 1;\n      try { e.currentTarget.setPointerCapture(e.pointerId); } catch (_) {}\n      this.setState({ dragging: true, dragX: 0 });\n    };\n    this.ptrMove = (e) => {\n      if (!this.state.dragging) return;\n      let dx = e.clientX - this.sx;\n      const n = this.slideCount();\n      const s = this.state.slide;\n      if ((s === 0 && dx > 0) || (s === n - 1 && dx < 0)) dx = dx / 3;\n      this.setState({ dragX: dx });\n    };\n    this.ptrUp = () => {\n      if (!this.state.dragging) return;\n      const dx = this.state.dragX;\n      const th = Math.min(80, this.vw * 0.15);\n      const n = this.slideCount();\n      let s = this.state.slide;\n      if (dx < -th) s += 1; else if (dx > th) s -= 1;\n      s = Math.max(0, Math.min(n - 1, s));\n      this.setState({ dragging: false, dragX: 0, slide: s });\n    };\n  }\n\n  // ─────────────────────────────────────────────\n  // CONTEÚDO DO MÊS — substitua a cada cliente.\n  // tipo: 'carrossel' | 'reel' | 'imagem'\n  // capa / slides / imagem / video: URL do arquivo ('' = espaço reservado)\n  // ─────────────────────────────────────────────\n  conteudo() {\n    return [\n      {\n        tipo: 'carrossel', data: '03/11', rotulo: 'Loja ou parceiro?',\n        titulo: 'Loja de informática ou parceiro de tecnologia? A diferença que aparece no seu orçamento',\n        slides: ['imagens/p01-s01.png', 'imagens/p01-s02.png', 'imagens/p01-s03.png', 'imagens/p01-s04.png', 'imagens/p01-s05.png', 'imagens/p01-s06.png', 'imagens/p01-s07.png'],\n        legenda: 'Comprar tecnologia é fácil. Difícil é comprar a tecnologia certa. Se esse post te lembrou de alguma compra que não resolveu o problema, você já sabe a diferença entre uma loja e um parceiro.'\n      },\n      {\n        tipo: 'imagem', formato: 'Frase', data: '05/11', rotulo: 'Entender e planejar',\n        titulo: 'Antes de vender, a gente entende. Antes de instalar, a gente planeja.',\n        imagem: 'imagens/p02.png',\n        legenda: 'Toda recomendação da Covatti começa com perguntas sobre a rotina da sua empresa: quantas pessoas usam a rede, quais sistemas não podem parar, o que já existe e funciona bem. Só depois disso a gente fala em equipamento. Tecnologia boa é a que resolve o problema certo. Chama a gente no direct para conversar.'\n      },\n      {\n        tipo: 'carrossel', data: '10/11', rotulo: 'Mito do antivírus',\n        titulo: 'Mito: “Tenho antivírus, então estou protegido”',\n        slides: ['imagens/p03-s01.png', 'imagens/p03-s02.png', 'imagens/p03-s03.png', 'imagens/p03-s04.png', 'imagens/p03-s05.png', 'imagens/p03-s06.png', 'imagens/p03-s07.png'],\n        legenda: 'Antivírus sozinho não protege uma empresa. Ele é uma camada, e uma rede bem protegida precisa de várias trabalhando juntas. Salve este post para conferir como está a sua.'\n      },\n      {\n        tipo: 'reel', data: '11/11', rotulo: 'Dentro do rack',\n        titulo: 'Brinde: um técnico mostra o que tem dentro de um rack',\n        capa: '', video: '',\n        roteiro: 'HOOK (0–3s)\\n[Técnico apontando para o rack]\\n“Toda empresa tem um desses. E quase ninguém sabe o que tem aqui dentro.”\\n\\nDESENVOLVIMENTO\\n“Esse é o rack, o armário onde fica o coração da rede da empresa. Aqui em cima [aponta] estão os switches, que distribuem a rede para cada computador, impressora e câmera. Todos esses cabos saem daqui e chegam até cada mesa. Aqui [aponta] fica o firewall, que controla o que entra e o que sai da rede. E aqui embaixo [aponta] fica o nobreak, que mantém tudo ligado quando a energia oscila.”\\n\\nVIRADA\\n“Quando esse armário está bagunçado, com cabo sem identificação e equipamento esquentando, um problema simples vira horas de procura. Organizado assim, a gente encontra e resolve em minutos.”\\n\\nCTA\\n“Se você nunca abriu o rack da sua empresa, ou tem medo do que vai encontrar aí dentro, chama a Covatti no direct.”',\n        legenda: 'Ele fica num canto da sala e quase ninguém olha para ele, mas é ali que a rede inteira da sua empresa funciona. Hoje um dos nossos técnicos mostra o que tem dentro de um rack e por que a organização dele faz tanta diferença no dia a dia.'\n      },\n      {\n        tipo: 'imagem', formato: 'Leia a legenda', data: '12/11', rotulo: 'Nossa equipe',\n        titulo: 'Quem está por trás da Covatti',\n        imagem: 'imagens/p05.png',\n        legenda: 'Por trás de cada rede funcionando, servidor no ar e backup em dia, tem gente. Essa é a equipe da Covatti.\\n[Apresentar cada pessoa: nome, função e há quanto tempo está na Covatti]\\nSão 12 anos atendendo empresas do Oeste catarinense. O que nos trouxe até aqui foi a forma de trabalhar: entender cada cliente antes de recomendar qualquer coisa e continuar por perto depois que tudo está instalado.\\nQuando você chamar a Covatti, é com essas pessoas que vai falar. Manda um oi no direct.'\n      },\n      {\n        tipo: 'carrossel', data: '17/11', rotulo: 'Seu backup funciona?',\n        titulo: 'Seu backup funciona? 3 perguntas para descobrir hoje',\n        slides: ['imagens/p06-s01.png', 'imagens/p06-s02.png', 'imagens/p06-s03.png', 'imagens/p06-s04.png', 'imagens/p06-s05.png', 'imagens/p06-s06.png', 'imagens/p06-s07.png'],\n        legenda: 'Backup é aquela coisa que todo mundo acha que tem, até precisar. Responda as 3 perguntas do carrossel e salve para mostrar a quem cuida da TI aí na empresa.'\n      },\n      {\n        tipo: 'imagem', formato: 'Leia a legenda', data: '19/11', rotulo: 'TI em 2027',\n        titulo: 'Planejamento de TI para 2027: por que fazer agora',\n        imagem: 'imagens/p07.png',\n        legenda: 'Fim de ano é quando a maioria das empresas fecha o orçamento do ano seguinte. E é comum a TI ficar de fora até que algo quebre. Aí a compra vira urgência, sem tempo de comparar nem de planejar.\\nPor isso vale olhar para a tecnologia agora. Alguns pontos para colocar na conta:\\n\\n1. Equipamentos: quais computadores e notebooks já estão no limite e vão precisar de troca ao longo do ano?\\n2. Licenças: quais softwares vencem em 2027, e estão todos regularizados?\\n3. Segurança e backup: a empresa tem firewall, backup testado e controle de acesso? Se não, isso entra como prioridade.\\n4. Rede e Wi-Fi: a estrutura aguenta o crescimento da equipe previsto para o ano?\\n5. Suporte: quem atende quando algo para?\\n\\nPlanejar a TI é trocar compra de emergência por investimento pensado. E é aí que a Covatti ajuda: avaliamos a estrutura atual da sua empresa e mostramos o que precisa de atenção, o que pode esperar e o que não precisa ser comprado.\\nQuer começar 2027 com a TI planejada? Chame no direct ou no WhatsApp e agende um diagnóstico.'\n      }\n    ];\n  }\n\n  slideSources(p) {\n    if (!p) return [];\n    if (p.tipo === 'carrossel') return p.slides || [];\n    if (p.tipo === 'imagem') return [p.imagem || ''];\n    return [];\n  }\n\n  slideCount() {\n    const i = this.state.open;\n    if (i === null || i === undefined) return 0;\n    const p = this.conteudo()[i];\n    return p && p.tipo === 'carrossel' ? (p.slides || []).length : 0;\n  }\n\n  componentDidUpdate(prevProps, prevState) {\n    const isOpen = this.state.open !== null && this.state.open !== undefined; if (isOpen && !this._wasOpen) { setTimeout(() => { const el = this.dialogEl || document.querySelector('[role=dialog]'); if (el) { try { el.focus({ preventScroll: true }); } catch (_) { el.focus(); } } }, 30); } this._wasOpen = isOpen;\n  }\n\n  openPost(i) {\n    try { this.lastFocus = document.activeElement; } catch (_) { this.lastFocus = null; }\n    this.setState({ open: i, slide: 0, playing: false, dragX: 0, dragging: false, menuOpen: false });\n  }\n\n  renderVals() {\n    const s = this.state;\n    const data = this.conteudo();\n    const tones = [\n      { bg: '#8c52ff', fg: '#fdf9ec' },\n      { bg: '#c1ff72', fg: '#1c1530' },\n      { bg: '#1c1530', fg: '#c1ff72' },\n      { bg: '#ece3c4', fg: '#1c1530' }\n    ];\n    const typeLabels = { carrossel: 'Carrossel', reel: 'Reel', imagem: 'Imagem' };\n\n    const posts = data.map((p, i) => {\n      const t = tones[i % tones.length];\n      const capa = p.capa || (p.tipo === 'carrossel' ? ((p.slides || [])[0] || '') : p.tipo === 'imagem' ? (p.imagem || '') : '');\n      return {\n        n: i + 1,\n        num: String(i + 1).padStart(2, '0'),\n        rotulo: p.rotulo,\n        typeLabel: typeLabels[p.tipo] || 'Post',\n        data: p.data || '',\n        isCarousel: p.tipo === 'carrossel',\n        isReel: p.tipo === 'reel',\n        isImage: p.tipo === 'imagem',\n        capa: capa,\n        hasCover: !!capa,\n        noCover: !capa,\n        bg: t.bg,\n        fg: t.fg,\n        itemClass: 'sb-item' + (s.open === i ? ' is-active' : ''),\n        current: s.open === i ? 'true' : 'false',\n        open: () => this.openPost(i)\n      };\n    });\n\n    const count = (tipo) => data.filter((p) => p.tipo === tipo).length;\n    const plural = (n, a, b) => n + ' ' + (n === 1 ? a : b);\n    const parts = [plural(data.length, 'publicação', 'publicações')];\n    if (count('carrossel')) parts.push(plural(count('carrossel'), 'carrossel', 'carrosséis'));\n    if (count('reel')) parts.push(plural(count('reel'), 'reel', 'reels'));\n    if (count('imagem')) parts.push(plural(count('imagem'), 'imagem', 'imagens'));\n\n    const isOpen = s.open !== null && s.open !== undefined;\n    const p = isOpen ? data[s.open] : null;\n    const it = isOpen ? posts[s.open] : null;\n    const srcs = this.slideSources(p);\n    const isCarousel = !!(p && p.tipo === 'carrossel');\n    const isReel = !!(p && p.tipo === 'reel');\n    const n = srcs.length;\n\n    const slides = srcs.map((src, j) => ({\n      src: src,\n      has: !!src,\n      none: !src,\n      bg: it ? it.bg : '#6c2ee6',\n      fg: it ? it.fg : '#fdf9ec',\n      hidden: j === s.slide ? 'false' : 'true',\n      label: isCarousel ? (j === 0 ? 'Capa' : 'Slide ' + (j + 1)) : 'Imagem',\n      alt: isCarousel ? 'Slide ' + (j + 1) + ' de ' + n : 'Imagem do post'\n    }));\n    const dots = isCarousel ? srcs.map((_, j) => ({ cls: j === s.slide ? 'dot on' : 'dot' })) : [];\n\n    const caption = p ? String(p.legenda || '') : '';\n    const captionSegs = caption.split(/([#@][^\\s#@]+)/g).filter((x) => x !== '').map((x) => {\n      const tag = /^[#@]/.test(x);\n      return { t: x, tag: tag, plain: !tag };\n    });\n\n    let meta = '';\n    if (p) {\n      meta = (p.formato || typeLabels[p.tipo] || 'Post') + (isCarousel ? ' · ' + n + ' slides' : '') + (p.data ? ' · ' + p.data : '') + ' · Post ' + (s.open + 1) + ' de ' + data.length;\n    }\n    const roteiro = p && p.roteiro ? String(p.roteiro) : '';\n    const hasVideo = !!(p && p.video);\n\n    return {\n      posts: posts,\n      feed: posts.slice().reverse(),\n      curTitulo: p && p.titulo ? p.titulo : '',\n      hasTitulo: !!(p && p.titulo),\n      roteiro: roteiro,\n      hasRoteiro: !!roteiro,\n      showPlay: hasVideo,\n      showPending: !hasVideo,\n      summary: parts.join(' · '),\n      listClass: 'sb-list' + (s.menuOpen ? ' open' : ''),\n      menuExpanded: s.menuOpen ? 'true' : 'false',\n      toggleMenu: this.toggleMenu,\n\n      isOpen: isOpen,\n      curN: it ? it.n : '',\n      curRotulo: it ? it.rotulo : '',\n      curMeta: meta,\n      curAria: it ? 'Post ' + it.n + ': ' + it.typeLabel + ', ' + it.rotulo : 'Post',\n      curBg: it ? it.bg : '#6c2ee6',\n      curFg: it ? it.fg : '#fdf9ec',\n      curCapa: it ? it.capa : '',\n      curHasCover: !!(it && it.hasCover),\n      curNoCover: !(it && it.hasCover),\n      curVideo: p && p.video ? p.video : '',\n\n      curHasSlides: n > 0,\n      isCarousel: isCarousel,\n      isReel: isReel,\n      slides: slides,\n      dots: dots,\n      counter: (s.slide + 1) + '/' + n,\n      canPrev: isCarousel && s.slide > 0,\n      canNext: isCarousel && s.slide < n - 1,\n      prev: this.prev,\n      next: this.next,\n      trackClass: 'track' + (s.dragging ? ' is-dragging' : ''),\n      trackTransform: 'translateX(calc(' + (-s.slide * 100) + '% + ' + s.dragX + 'px))',\n      ptrDown: this.ptrDown,\n      ptrMove: this.ptrMove,\n      ptrUp: this.ptrUp,\n\n      showCover: isReel && !s.playing,\n      showVideo: isReel && s.playing && !!(p && p.video),\n      showVideoMissing: isReel && s.playing && !(p && p.video),\n      play: this.play,\n\n      captionSegs: captionSegs,\n      close: this.close,\n      stop: this.stop,\n      onKey: this.onKey,\n      setDialog: this.setDialog\n    };\n  }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
